# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# ── Virtual env & tool caches (regenerated by `uv sync` / tooling) ─────────
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ── Secrets / environment (NEVER commit) ───────────────────────────────────
# Bare `.env` matches the file in any directory (root and deploy/compose/).
.env
*.env.local
# `.env.example` templates are intentionally tracked.

# ── Local runtime data & generated artefacts (keep dirs, ignore contents) ──
/threads.db
/library/*
!/library/.gitkeep
/images/*
!/images/.gitkeep
/sandbox-work/*
!/sandbox-work/.gitkeep

# ── IDE / editor ────────────────────────────────────────────────────────────
.idea/
.vscode/

# ── Claude Code local config (machine-specific; not part of the project) ───
.claude/

# ── OS cruft ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Personal scratch notes (not part of the project) ───────────────────────
/testing.txt
/featurerefactor01-officer  should b.txt
