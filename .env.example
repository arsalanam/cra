# ─── AWS Bedrock Configuration ────────────────────────────────────────────────
# Option 1: Use AWS profile (recommended for local dev)
AWS_PROFILE=default

# Option 2: Explicit credentials
#AWS_ACCESS_KEY_ID=your-access-key-id
#AWS_SECRET_ACCESS_KEY=your-secret-access-key
#AWS_DEFAULT_REGION=us-east-1

# ─── Bedrock Model ─────────────────────────────────────────────────────────────
# Cross-region inference profile (recommended — higher throughput).
# Haiku is the cost-conscious default; switch to a Sonnet / Opus tier when
# a workflow needs deeper reasoning (e.g. complex meta-analyses).
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Alternative models to try:
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
# BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# ─── App Settings ──────────────────────────────────────────────────────────────
APP_PORT=8000
LOG_LEVEL=info

# ─── Tavily Web Search ────────────────────────────────────────────────────────
# Get your free API key at https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# ─── Docker Sandbox ───────────────────────────────────────────────────────────
# Build first: docker build -t pydantic-sandbox:latest ./sandbox
SANDBOX_IMAGE=pydantic-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_COUNT=1.0
SANDBOX_ENABLED=true
