# Copy to `.env` next to docker-compose.yml and fill in your credentials.
# All values are pulled by docker-compose.yml via ${VAR} substitution and
# forwarded into the agent container as env vars.

# ─── AWS Bedrock (model inference) ─────────────────────────────────────────
# Profile-based auth (default): docker-compose.yml mounts your host ~/.aws
# read-only and selects this profile. Must be a plain key/secret profile —
# SSO / credential_process profiles do NOT resolve inside the container.
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1

# Cost-conscious default; switch to a Sonnet/Opus tier per workflow when needed.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ─── Postgres (local compose) ──────────────────────────────────────────────
# Matches docker-compose.yml's postgres service. The agent reads
# DATABASE_URL directly — change all four together if you customise.
POSTGRES_USER=cra
POSTGRES_PASSWORD=cra
POSTGRES_DB=cra
DATABASE_URL=postgresql+asyncpg://cra:cra@postgres:5432/cra

# ─── External APIs ─────────────────────────────────────────────────────────
TAVILY_API_KEY=
NCBI_API_KEY=

# ─── Daily token budgets ───────────────────────────────────────────────────
# Aggregated across all turns + watches. 0 disables enforcement.
MAX_INPUT_TOKENS_PER_DAY=3000000
MAX_OUTPUT_TOKENS_PER_DAY=600000

# ─── Sandbox docker-out-of-docker (advanced) ───────────────────────────────
# The agent sees /work/sandbox internally; the host docker daemon sees
# the absolute path below. Set this to the absolute path of `sandbox-work/`
# on YOUR machine (the directory bind-mounted into the agent container).
HOST_SANDBOX_WORK_DIR=

# ─── Local publication cache (R0) ──────────────────────────────────────────
# Everything search_papers / fetch_pmc_fulltext retrieves is cached locally
# (metadata + abstracts in Postgres, raw full text in ../../library, which is
# bind-mounted to /work/library). Set to false to disable the write-through.
LIBRARY_CACHE_ENABLED=true

# ─── Embeddings (R2) ───────────────────────────────────────────────────────
# Titan Text Embeddings v2 on Bedrock. Cached passages are embedded by an
# in-process background drain (no Celery/Redis — see architecture.md). Set
# EMBEDDING_ENABLED=false to skip embedding. Changing the model/dimension
# requires a re-embed: scripts/backfill_embeddings.py --reembed.
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENABLED=true

# ─── AWS Cognito (identity) ────────────────────────────────────────────────
# Run scripts/cognito_setup.py and paste its output here. Leave blank in
# dev to skip auth entirely (the app's auth middleware short-circuits when
# cognito_user_pool_id is unset).
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=                                # e.g. https://cra-yourname.auth.us-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:8000/auth/callback

# High-entropy random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_COOKIE_SECRET=
